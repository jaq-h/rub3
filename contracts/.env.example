# ── RPC + API keys ────────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# ── Deployer ──────────────────────────────────────────────────────────────────
# Either set DEPLOYER_KEY or use --ledger / --trezor on the forge command line.
DEPLOYER_KEY=

# ── DeployFactory.s.sol - required ────────────────────────────────────────────
# Only for deploying a Rub3Factory. Both are frozen at the factory's construction
# and stamped on every licence contract it ever deploys, so neither can be
# changed afterwards - see contracts.md → "The protocol fee".
FEE_BPS=                      # protocol fee in bps, within MIN/MAX_FEE_BPS (200-300)
TREASURY=                     # fee recipient; non-zero, and must be able to receive ETH

# ── Deploy.s.sol — required ───────────────────────────────────────────────────
CONTRACT_TYPE=access          # access | subscription
TOKEN_NAME=My App License
TOKEN_SYMBOL=MAL
IDENTITY_MODEL=0              # 0 = access (user_id = wallet)  |  1 = account (user_id = TBA)
PRICE=50000000000000000       # 0.05 ETH in wei

# ── Deploy.s.sol — optional ───────────────────────────────────────────────────
# Launch release binary hashes, comma-separated (one per platform). Seeds the
# append-only hash set; later builds are added with addWrapperHash(bytes32).
# Leave unset to deploy with an empty set. WRAPPER_HASH is the one-hash shorthand.
# WRAPPER_HASHES=0xaaaa...,0xbbbb...
# The stablecoin rail, sold alongside ETH. Independent quotes, not a conversion.
# The token must expose the FiatTokenV2_2-style `bytes signature` overload of
# receiveWithAuthorization - see contracts.md → "Which payment tokens work".
# PRICE_TOKEN=0x...           # EIP-3009 ERC-20 accepted alongside ETH; unset = ETH only
# PRICE_AMOUNT=5000000        # price in PRICE_TOKEN's smallest unit (USDC: 6 decimals)
SUPPLY_CAP=0                  # 0 = uncapped; immutable once deployed
COOLDOWN_BLOCKS=1800          # blocks between activations; floor is 15 (~30s on Base)
# PREDECESSOR=0x...           # contract whose holders may claim onto this one; frozen at deploy
# OWNER=0x...                 # defaults to broadcaster if unset
# The Rub3Factory to deploy through. Deploying through one stamps the protocol
# fee and records the contract in isDeployed, which is what the registry and
# marketplace list. Unset or 0x0 deploys directly: no fee, and unrecorded.
# FACTORY=0x...               # Rub3Factory address; unset = direct deploy

# ── Subscription only ─────────────────────────────────────────────────────────
# PERIOD=2592000              # 30 days in seconds
