# ── RPC + API keys ────────────────────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# ── Deployer ──────────────────────────────────────────────────────────────────
# Either set DEPLOYER_KEY or use --ledger / --trezor on the forge command line.
DEPLOYER_KEY=

# ── DeployFactory.s.sol - required ────────────────────────────────────────────
# Only for deploying a Rub3Factory. Both are frozen at the factory's construction
# and stamped on every licence contract it ever deploys, so neither can be
# changed afterwards - see contracts.md → "The protocol fee".
FEE_BPS=                      # protocol fee in bps, within MIN/MAX_FEE_BPS (200-300)
TREASURY=                     # fee recipient; non-zero, and must be able to receive ETH
# The factory this one supersedes. Unset (or 0x0) for the FIRST factory only; set
# it on every later one, or the contracts the old factory recorded stop being
# acceptable predecessors on the new one. Immutable, so it cannot be added later.
# PREVIOUS_FACTORY=0x...      # earlier Rub3Factory; unset = this is the first

# ── Deploy.s.sol - required ───────────────────────────────────────────────────
CONTRACT_TYPE=access          # access | subscription
TOKEN_NAME=My App License
TOKEN_SYMBOL=MAL
IDENTITY_MODEL=0              # 0 = access (user_id = wallet)  |  1 = account (user_id = TBA)
PRICE=50000000000000000       # 0.05 ETH in wei

# ── Deploy.s.sol - optional ───────────────────────────────────────────────────
# Launch release binary hashes, comma-separated (one per platform). Seeds the
# append-only hash set; later builds are added with addWrapperHash(bytes32).
# Leave unset to deploy with an empty set. WRAPPER_HASH is the one-hash shorthand.
# WRAPPER_HASHES=0xaaaa...,0xbbbb...
# The stablecoin rail, sold alongside ETH. Independent quotes, not a conversion.
# The token must expose the FiatTokenV2_2-style `bytes signature` overload of
# receiveWithAuthorization - see contracts.md → "Which payment tokens work".
# PRICE_TOKEN=0x...           # EIP-3009 ERC-20 accepted alongside ETH; unset = ETH only
# PRICE_AMOUNT=5000000        # price in PRICE_TOKEN's smallest unit (USDC: 6 decimals)
SUPPLY_CAP=0                  # 0 = uncapped; immutable once deployed
COOLDOWN_BLOCKS=1800          # blocks between activations; floor is 15 (~30s on Base)
# PREDECESSOR=0x...           # contract whose holders may claim onto this one; frozen at deploy
#                             # deploying through a FACTORY additionally requires
#                             # this to be a contract that factory (or one in its
#                             # PREVIOUS_FACTORY chain) recorded
# OWNER=0x...                 # defaults to broadcaster if unset
# The Rub3Factory to deploy through. This env var alone decides which of the two
# deploy paths you get, and there is no other signal that you took one:
#
#   FACTORY unset (or 0x0)  ->  DIRECT deploy. FEE-FREE and UNRECORDED. Fully
#                               functional - same bytecode behaviour, same rails,
#                               same wrapper - but it gets no isDeployed row, so
#                               it has no canonical record and is not eligible
#                               for the planned registry/marketplace. This is the
#                               DEFAULT: forget the variable and this is what you
#                               deployed.
#   FACTORY set to the published canonical Rub3Factory address
#                           ->  REGISTERED deploy. Stamps the protocol fee
#                               (200-300 bps, immutable) and records the contract
#                               in that factory's isDeployed.
#
# Setting FACTORY to any OTHER factory pays that factory's treasury and records
# you only on that factory - it is not the canonical path.
# Which factory is canonical on a given chain is published in deployments.json,
# keyed by chain id. Read it in your shell, not here: this file is loaded by
# forge's dotenv reader, which substitutes variables but never runs commands, so
# a $(...) written as a value below would be taken literally. Run this from
# contracts/, then paste the address it prints into FACTORY= on the last line:
#
#   $ CHAIN_ID=8453 # 84532 for Base Sepolia
#   $ jq -er --arg id "$CHAIN_ID" ".chains[\$id].factory // error(\"no canonical factory is published for chain \(\$id)\")" deployments.json
#
# Today it prints nothing on every chain and reports that error instead: the
# contracts are not deployed to mainnet or declared ready for use until the
# registry is ready - the factory and the registry launch together. So there is
# nothing to paste, which is the point. Do not substitute a "null" or a
# guessed address: forge reads a FACTORY it cannot parse exactly as it reads an
# unset one, as "no factory", and deploys directly, fee-free and unrecorded.
# See contracts.md -> "Deploying through the factory".
# FACTORY=0x...               # Rub3Factory address; unset = direct, fee-free, unrecorded

# ── Subscription only ─────────────────────────────────────────────────────────
# PERIOD=2592000              # 30 days in seconds
